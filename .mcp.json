{
  "mcpServers": {
    "paper-search": {
      "command": "uvx",
      "args": [
        "paper-search-mcp"
      ],
      "autoStart": false
    },
    "jobspy": {
      "command": "node",
      "args": [
        "/Users/devang/Desktop/interview_prep/custom-mcps/jobspy-mcp-server/src/index.js"
      ],
      "env": {
        "ENABLE_SSE": "0",
        "JOBSPY_DOCKER_IMAGE": "jobspy"
      },
      "autoStart": false
    },
    "job-search": {
      "command": "npx",
      "args": [
        "-y",
        "@servation/job-search-mcp"
      ],
      "autoStart": false
    }
  }
}
