{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "build": {
    "env": {
      "UV_LINK_MODE": "copy"
    }
  },
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|assets/|vendor/|workers/|.*\\.[A-Za-z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
