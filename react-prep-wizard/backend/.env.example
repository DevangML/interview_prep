# Managed Postgres connection string from your provider.
# `postgres://` and `postgresql://` forms are normalised automatically.
DATABASE_URL=postgresql://user:password@host:5432/reactprep

# REQUIRED in production. Rotating this invalidates every live session.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_PEPPER=

SESSION_TTL_DAYS=30
ENVIRONMENT=production

# Only needed if the frontend is served from a different origin than the API.
CORS_ORIGINS=

# Path (relative to backend/) of the built Vite bundle.
STATIC_DIR=../dist
