{
  "name": "react-workbench",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:api\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "npm run build && concurrently \"npm run preview\" \"npm run dev:api\"",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "audit:graph": "esbuild scripts/auditGraph.ts --bundle --platform=node --format=cjs --outfile=.tmp/audit.cjs && node .tmp/audit.cjs",
    "check:projects": "esbuild scripts/checkProjectCoverage.ts --bundle --platform=node --format=cjs --outfile=.tmp/check.cjs && node .tmp/check.cjs",
    "content": "esbuild scripts/buildContent.ts --bundle --platform=node --format=cjs --outfile=.tmp/build-content.cjs && node .tmp/build-content.cjs",
    "dev:api": "cd backend && .venv/bin/alembic upgrade head && .venv/bin/uvicorn app.main:app --reload --port 8777"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@emmetio/codemirror6-plugin": "^0.4.1",
    "@mlc-ai/web-llm": "^0.2.84",
    "@replit/codemirror-vim": "^6.4.0",
    "@tanstack/react-query": "^5.102.2",
    "@tanstack/react-query-devtools": "^5.102.2",
    "@types/canvas-confetti": "^1.9.0",
    "@uiw/react-codemirror": "^4.23.7",
    "canvas-confetti": "^1.9.4",
    "comlink": "^4.4.2",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^2.1.7",
    "react-router": "^7.6.0",
    "use-debounce": "^10.0.4",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/babel__traverse": "^7.28.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.25.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
