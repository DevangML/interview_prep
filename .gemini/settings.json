{
  "mcpServers": {
    "jobspy": {
      "command": "node",
      "args": [
        "/Users/devang/Desktop/interview_prep/custom-mcps/jobspy-mcp-server/src/index.js"
      ],
      "env": {
        "ENABLE_SSE": "0",
        "JOBSPY_DOCKER_IMAGE": "jobspy"
      }
    },
    "job-search": {
      "command": "npx",
      "args": ["-y", "@servation/job-search-mcp"]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/devang/Desktop/interview_prep/.bmad-loop/bmad_loop_hook.py SessionStart",
            "timeout": 60000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/devang/Desktop/interview_prep/.bmad-loop/bmad_loop_hook.py Stop",
            "timeout": 60000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/devang/Desktop/interview_prep/.bmad-loop/bmad_loop_hook.py SessionEnd",
            "timeout": 60000
          }
        ]
      }
    ]
  }
}
